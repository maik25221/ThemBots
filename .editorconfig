root = true

[*.java]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true

# Java-specific style
max_line_length = 120

# IntelliJ reformatting rules
ij_java_align_multiline_parameters = true
ij_java_align_multiline_parameters_in_calls = true
ij_java_align_group_field_declarations = false
ij_java_space_before_method_call_parentheses = false
ij_java_space_before_method_parentheses = false
ij_java_space_within_parentheses = false
ij_java_blank_lines_after_package = 1
ij_java_blank_lines_before_class = 1
ij_java_blank_lines_after_class_header = 1
ij_java_blank_lines_before_method = 1
ij_java_blank_lines_after_method = 1
